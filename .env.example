# KHAN AI — ENVIRONMENT TEMPLATE
# Copy to .env and fill in real values. NEVER commit your real .env (it is gitignored).

# SQLite database location (kept outside the repo in /db)
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# REQUIRED IN PRODUCTION — session signing secret.
# Generate a strong one:  openssl rand -base64 48
# If missing in production, KHAN falls back to an ephemeral random secret
# (sessions reset on every restart — still unforgeable, but set this properly).
AUTH_SECRET="paste-64-plus-random-characters-here"

# Comma-separated allowlist of admin emails (protects /admin/* routes).
# Leave empty to keep the admin area completely locked.
ADMIN_EMAILS="you@example.com"

# Support-ticket email delivery (optional). Until set, tickets are saved to the
# database only and email delivery is skipped gracefully.
# Create at: Google Account → Security → 2-Step Verification → App passwords
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
# OTP_DEV_ECHO — leave UNSET in production (preview-sandbox testing only)
